EXIM_API_KEY=your_korea_exim_api_key

# Login mode: demo keeps the current test-user switcher.
# Change to supabase only after the Supabase project and portal_profiles table are ready.
NEXT_PUBLIC_OPS_AUTH_MODE=demo
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
# Server only: required for password completion and administrator provisioning.
SUPABASE_SERVICE_ROLE_KEY=your_server_only_service_role_key

# Optional shared storage for Vercel / other PCs.
# Deploy google-apps-script/ops-shared-storage.gs as a Google Apps Script Web App,
# then paste the Web App URL and the same secret here and in Vercel Environment Variables.
OPS_SHARED_STORAGE_URL=https://script.google.com/macros/s/your_web_app_id/exec
OPS_SHARED_STORAGE_SECRET=change-this-secret

# Optional live receivables source.
# Add JSON mode to the existing receivables Google Apps Script web app,
# then paste its /exec URL here and in Vercel Environment Variables.
OPS_RECEIVABLES_WEBAPP_URL=https://script.google.com/macros/s/your_receivables_web_app_id/exec
